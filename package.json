{
  "name": "switch",
  "version": "0.1.0",
  "private": true,
  "description": "Copy local agent skills into Cosmos (user or Space VFS).",
  "license": "MIT",
  "author": "Unnat Sharma <unnat.sharma@harness.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unnat-sharma/switch.git"
  },
  "type": "module",
  "bin": {
    "switch": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p . && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit -p .",
    "test": "npm run build && node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
